{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiseByDay",
  "version": "../package.json",
  "identifier": "com.joshuarashtian.risebyday",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "DayByDay",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "width": 800,
        "height": 600,
        "decorations": true,
        "zoomHotkeysEnabled": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyQzYxMzBBNTIzNjNGREQKUldUZFB6WlNDaFBHZ2gvam1ydDl2N01nMHFiUHpVU0s1UldlQk5QVGhDaFY5bXMvb2ZaOTMxenoK",
      "endpoints": [
        "https://github.com/joshrashtian/RiseByDay/releases/latest/download/latest.json"
      ]
    }
  }
}
