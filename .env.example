VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Projects — hidden unless VITE_ENABLE_PROJECTS=true (the screen is a stub).
VITE_ENABLE_PROJECTS=

# Spotify — hidden unless VITE_ENABLE_SPOTIFY=true (the Spotify API caps
# non-extended apps to allowlisted dev users). Client ID can also be pasted
# into Settings → Spotify.
# Not a secret: the desktop app uses Authorization Code + PKCE, no client secret.
# Register http://127.0.0.1:14565/callback as the redirect URI in the Spotify dashboard.
VITE_ENABLE_SPOTIFY=
VITE_SPOTIFY_CLIENT_ID=

# Google Calendar — hidden unless VITE_ENABLE_GOOGLE_CALENDAR=true.
# Create an OAuth client of type "Desktop app" in Google Cloud Console and
# enable the Google Calendar API. Loopback redirects (http://127.0.0.1:14566)
# need no registration for Desktop clients. Google requires the client secret
# on the token endpoint even with PKCE; it is not confidential for desktop apps.
VITE_ENABLE_GOOGLE_CALENDAR=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
